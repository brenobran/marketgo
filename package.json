{
  "name": "marketgo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest && node --test \"supabase/tests/*.test.mjs\"",
    "test:app": "jest",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app src __tests__ supabase"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@hookform/resolvers": "^5.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.87.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
